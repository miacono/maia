# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/maia
AUDIT_DATABASE_URL=postgresql+asyncpg://audit_user:password@localhost:5432/maia

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ─── Security ─────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
