# ─── Database ────────────────────────────────────────────────────────────────
# API connection (SELECT/INSERT/UPDATE only — no DELETE, soft delete only)
DATABASE_URL=postgresql+asyncpg://maia_app:password@localhost:5432/maia
# Alembic migrations (schema owner, DDL)
MIGRATION_DATABASE_URL=postgresql+asyncpg://maia_migrator:password@localhost:5432/maia
# Audit chain verification
AUDIT_DATABASE_URL=postgresql+asyncpg://maia_audit:password@localhost:5432/maia

# ─── Local database container (infrastructure/docker/docker-compose.yml) ─────
# Read only by docker compose to initialize the container on first start.
# Users, passwords and database name must match the URLs above.
# Generate passwords with: openssl rand -hex 24
POSTGRES_DB=maia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
MAIA_DB_MIGRATOR_USER=maia_migrator
MAIA_DB_MIGRATOR_PASSWORD=
MAIA_DB_APP_USER=maia_app
MAIA_DB_APP_PASSWORD=
MAIA_DB_AUDIT_USER=maia_audit
MAIA_DB_AUDIT_PASSWORD=
MAIA_DB_PORT=5432

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ─── Security ─────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
